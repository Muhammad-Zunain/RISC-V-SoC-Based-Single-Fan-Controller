module imem_ip_wrapper #(
  parameter integer WORDS = 1024
) (
  input  logic        clk_i,
  input  logic        rst_i,
  input  logic        req_i,
  input  logic [31:0] addr_i,
  output logic        ready_o,
  output logic [31:0] rdata_o,
  output logic        fault_o
);
  localparam integer ADDR_W = $clog2(WORDS);

  logic [ADDR_W-1:0] ram_addr;
  logic [31:0] ram_q;
  logic pending_q;
  logic fault_pending_q;
  logic request_fault;

  assign request_fault = (addr_i[1:0] != 2'b00) || ((addr_i >> 2) >= WORDS);
  assign ram_addr = request_fault ? {ADDR_W{1'b0}} : addr_i[ADDR_W+1:2];

  // Generated by Quartus IP Catalog. Expected variation name: imem_ip.
  // Configure 32-bit x 1024, synchronous single-port RAM, q unregistered,
  // and initialize from soc_demo.mif. wren is tied low for instruction memory.
  imem_ip u_imem_ip (
    .address (ram_addr),
    .clock   (clk_i),
    .data    (32'd0),
    .wren    (1'b0),
    .q       (ram_q)
  );

  always_ff @(posedge clk_i) begin
    if (rst_i) begin
      pending_q       <= 1'b0;
      fault_pending_q <= 1'b0;
    end else begin
      pending_q <= req_i;
      if (req_i)
        fault_pending_q <= request_fault;
    end
  end

  assign ready_o = pending_q;
  assign fault_o = pending_q && fault_pending_q;
  assign rdata_o = fault_o ? 32'h0000_0013 : ram_q;
endmodule
